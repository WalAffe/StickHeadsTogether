# StickHeadsTogether Configuration
# Copy to ~/.config/stick-heads-together/.env and fill in your keys

# ──────────────────────────────────────────────────────────────
# API Keys (at least one required)
# ──────────────────────────────────────────────────────────────

# OpenAI - https://platform.openai.com/api-keys
# NOTE: ChatGPT Plus does NOT include API access. You need separate
#       API credits at https://platform.openai.com/account/billing
OPENAI_API_KEY=

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ──────────────────────────────────────────────────────────────
# Model Configuration (optional - defaults shown below)
# ──────────────────────────────────────────────────────────────
# Complexity is chosen per tool call: low / medium / high
# Override any of these to use different models per complexity level.

# ─── OpenAI Models ───
# Available: gpt-5.4, gpt-5.4-mini, gpt-5.4-nano
# Paid API only - no free tier. ~$5 minimum credit purchase required.
COUNCIL_OPENAI_LOW=gpt-5.4-mini
COUNCIL_OPENAI_MEDIUM=gpt-5.4-mini
COUNCIL_OPENAI_HIGH=gpt-5.4

# ─── Gemini Models ───
#
# FREE TIER (works without billing):
#   - gemini-2.5-flash         ✅ Recommended default
#   - gemini-2.5-flash-lite    ✅ Cheaper/faster
#   - gemini-2.5-pro           ✅ Higher quality, lower rate limits
#
# PAID TIER ONLY (billing required, otherwise "quota exceeded"):
#   - gemini-3.1-pro-preview       ❌ No free tier
#   - gemini-3-flash-preview       ❌ No free tier
#   - gemini-3.1-flash-lite-preview ❌ No free tier
#
# Free tier info: https://ai.google.dev/gemini-api/docs/rate-limits
COUNCIL_GEMINI_LOW=gemini-2.5-flash
COUNCIL_GEMINI_MEDIUM=gemini-2.5-flash
COUNCIL_GEMINI_HIGH=gemini-2.5-flash
